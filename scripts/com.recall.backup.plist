<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Automated Recall Qdrant Backup Service -->
    <key>Label</key>
    <string>com.recall.backup</string>

    <!-- Program to run -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/wrk/WorkDev/MCP-Dev/SemVecMem/scripts/backup-qdrant-auto.sh</string>
    </array>

    <!-- Working directory -->
    <key>WorkingDirectory</key>
    <string>/Users/wrk/WorkDev/MCP-Dev/SemVecMem</string>

    <!-- Run at fixed wall-clock hours: 02, 08, 14, 20.
         MUST be calendar-based, not StartInterval. The daily/weekly promotion in
         backup-qdrant-auto.sh tests `date +%H` = "02"; a relative interval drifts
         on every sleep and reboot, so that slot was only ever hit by luck.
         Daily promotion stopped 2026-08-10; weekly missed Sunday 2026-08-16. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <!-- Also run at startup (5 minutes after boot) -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Standard output log -->
    <key>StandardOutPath</key>
    <string>/Users/wrk/WorkDev/MCP-Dev/SemVecMem/logs/backup-stdout.log</string>

    <!-- Error log -->
    <key>StandardErrorPath</key>
    <string>/Users/wrk/WorkDev/MCP-Dev/SemVecMem/logs/backup-stderr.log</string>

    <!-- Keep job alive (restart on failure) -->
    <key>KeepAlive</key>
    <false/>

    <!-- Nice level (lower priority to not interfere with work) -->
    <key>Nice</key>
    <integer>10</integer>

    <!-- Environment variables -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
