# Recall memory persistence state (session-local, not version controlled)
.recall-session-state.json
.recall-session-handoff.json
.recall-breadcrumbs.jsonl

# Backup archives: Qdrant snapshots of a store holding medical data.
# This repo is PUBLIC and has no git-crypt. Never track these.
backups/

# Rendered launchd plist: machine-specific paths, generated by
# scripts/setup-auto-backup.sh from com.recall.backup.plist.template.
scripts/com.recall.backup.plist

# Windows VM Recall config: machine-specific, naming that host loopback end of
# the SSH tunnel and the Parallels host running Ollama. This repo is PUBLIC -
# do not track it. Regenerate from the RECALL_* environment block in that
# machine's MCP server configuration (qdrant mode/host/port, embedder
# type/model/host/port).
config-windows.yaml

# Local virtualenv. The venv/ pattern above does not match the dot-prefixed
# name, so a .venv/ shows up as untracked on every status.
.venv/
