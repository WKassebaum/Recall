{
  "name": "Recall Memory Plugins",
  "description": "External semantic memory for AI coding assistants - never lose context again",
  "version": "1.0.0",
  "author": {
    "name": "William Kassebaum",
    "url": "https://github.com/WKassebaum"
  },
  "homepage": "https://github.com/WKassebaum/Recall",
  "plugins": [
    {
      "name": "recall",
      "version": "1.3.3",
      "description": "Dual-mode memory system (semantic + episodic) - store decisions, discoveries, and milestones with vector embeddings. Search by meaning OR timeline. Zero cloud dependencies.",
      "repository": "https://github.com/WKassebaum/Recall",
      "author": "William Kassebaum",
      "keywords": [
        "memory",
        "vector-database",
        "embeddings",
        "semantic-search",
        "episodic-memory",
        "context-management",
        "qdrant",
        "mcp"
      ],
      "license": "Apache-2.0",
      "requirements": {
        "python": ">=3.10",
        "docker": "required"
      },
      "features": [
        "Semantic search by meaning",
        "Chronological timeline view",
        "Event-based organization (6 types)",
        "Session-based filtering",
        "Hybrid semantic + temporal queries",
        "Local-first (no cloud)",
        "High performance (<20ms queries)"
      ],
      "documentation": "https://github.com/WKassebaum/Recall#readme",
      "changelog": "https://github.com/WKassebaum/Recall/blob/master/CHANGELOG.md"
    }
  ]
}
